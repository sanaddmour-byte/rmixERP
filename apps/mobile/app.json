{
  "expo": {
    "name": "RMC ERP",
    "slug": "rmixerp",
    "scheme": "rmixerp",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "RMC ERP uses your photo library to attach goods-receipt photos.",
          "cameraPermission": "RMC ERP uses your camera to photograph received goods."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:3000/api"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rmixerp.mobile"
    },
    "android": {
      "package": "com.rmixerp.mobile"
    }
  }
}
