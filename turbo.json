{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "envMode": "loose",
  "tasks": {
    "generate": {
      "cache": true,
      "inputs": ["openapi.yaml", "orval.config.ts"],
      "outputs": ["generated/**"]
    },
    "typecheck": {
      "dependsOn": ["^generate", "generate"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^generate", "generate"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^generate", "generate"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^generate", "generate"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^generate", "generate"],
      "outputs": ["dist/**"]
    },
    "migrate": {
      "cache": false
    },
    "seed": {
      "cache": false
    }
  }
}
