# Copy to .env and fill in. Used by docker-compose.yml and (optionally) by
# running apps/api / packages/db commands directly on the host.

# --- Postgres (docker-compose's postgres service) ---
PG_OWNER_PASSWORD=postgres_dev_password
APP_DB_ROLE_PASSWORD=rmixerp_app_dev_password

# --- apps/api ---
PORT=3000
# Owner-role connection, used only for migrations (bypasses RLS).
MIGRATE_DATABASE_URL=postgres://postgres:postgres_dev_password@localhost:5432/rmixerp
# rmixerp_app-role connection, used for all normal request handling (RLS applies).
DATABASE_URL=postgres://rmixerp_app:rmixerp_app_dev_password@localhost:5432/rmixerp
RUN_MIGRATIONS_ON_BOOT=true
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Single-tenant at go-live: set this to the company id printed by
# `pnpm db:seed` (see README "First-time setup").
COMPANY_ID=

# --- packages/db seed (packages/db/seed/run.ts) ---
SEED_ADMIN_EMAIL=admin@rmixerp.local
SEED_ADMIN_PASSWORD=ChangeMe123!
# Optional: pin the seeded company's id instead of letting it be random.
# SEED_COMPANY_ID=00000000-0000-4000-8000-000000000001

# --- apps/web (Vite dev server) ---
VITE_API_BASE_URL=/api
API_PROXY_TARGET=http://localhost:3000

# --- apps/mobile (Expo) ---
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api

# --- test databases (packages/db and apps/api integration tests) ---
TEST_OWNER_DATABASE_URL=postgres://postgres:postgres_dev_password@localhost:5432/rmixerp_test
TEST_DATABASE_URL=postgres://rmixerp_app:rmixerp_app_dev_password@localhost:5432/rmixerp_test
TEST_COMPANY_ID=00000000-0000-4000-8000-000000000001
TEST_SEED_ADMIN_EMAIL=admin@test.local
TEST_SEED_ADMIN_PASSWORD=TestPass123!
